{
  "name": "acm-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "iPass Badge Check — Android app that verifies member badges against iPass",
  "scripts": {
    "dev": "node scripts/dev-server.js",
    "test": "node --test tests/",
    "build:local": "node scripts/build-config.js local",
    "build:staging": "node scripts/build-config.js staging",
    "build:prod": "node scripts/build-config.js prod"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "6.0.1",
    "@capacitor-community/privacy-screen": "5.2.1",
    "@capacitor-mlkit/barcode-scanning": "6.2.0",
    "@capacitor/android": "6.2.1",
    "@capacitor/app": "6.0.3",
    "@capacitor/core": "6.2.1",
    "@capacitor/haptics": "6.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.1"
  }
}
